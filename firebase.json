{
  "hosting": {
    "target": "cf-brews",
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "cf-brews", 
          "region": "us-central1"
        }
      },
      {
        "source": "/health.cfm",
        "run": {
          "serviceId": "cf-brews",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}